{
  "name": "Auto-Close Tabs by URL",
  "description": "Automatically close tabs that just launch apps and are otherwise useless. Specify which urls to match, and how fast to close them.",
  "version": "1.1.0",
  "manifest_version": 3,
  "permissions": [
    "alarms",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "close-app-launcher-tabs-16.png",
      "32": "close-app-launcher-tabs-32.png",
      "48": "close-app-launcher-tabs-48.png",
      "128": "close-app-launcher-tabs-128.png"
    }
  },
  "icons": {
    "16": "close-app-launcher-tabs-16.png",
    "32": "close-app-launcher-tabs-32.png",
    "48": "close-app-launcher-tabs-48.png",
    "128": "close-app-launcher-tabs-128.png"
  }
}
